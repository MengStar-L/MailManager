MAILMANAGER_ADDR=127.0.0.1:8080
MAILMANAGER_PUBLIC_URL=https://mail.example.com
MAILMANAGER_DATA_DIR=/opt/mailmanager/data
MAILMANAGER_DATABASE_PATH=/opt/mailmanager/data/mailmanager.db
MAILMANAGER_MASTER_KEY_FILE=/opt/mailmanager/config/master.key
MAILMANAGER_ATTACHMENT_CACHE_DIR=/opt/mailmanager/data/attachments
MAILMANAGER_ATTACHMENT_CACHE_BYTES=5368709120
MAILMANAGER_MAX_ATTACHMENT_BYTES=26214400
MAILMANAGER_SESSION_TTL=720h
MAILMANAGER_SETUP_TTL=30m
MAILMANAGER_LOGIN_CHALLENGE_TTL=5m
MAILMANAGER_AUTO_UPDATE_ENABLED=true
# The official installer manages these paths. If they change, update the
# systemd ExecStart/ReadWritePaths settings with matching drop-ins.
MAILMANAGER_UPDATE_INBOX_DIR=/opt/mailmanager/updater/inbox
MAILMANAGER_UPDATE_STATE_FILE=/opt/mailmanager/updater/status.json
MAILMANAGER_UPDATE_WORK_DIR=/opt/mailmanager/updater/work
MAILMANAGER_UPDATE_BACKUP_DIR=/opt/mailmanager/updater/backups
MAILMANAGER_UPDATE_BINARY_PATH=/opt/mailmanager/bin/mailmanager
MAILMANAGER_UPDATE_INSTALLED_VERSION_FILE=/opt/mailmanager/updater/installed-version
MAILMANAGER_UPDATE_READY_URL=http://127.0.0.1:8080/readyz
MAILMANAGER_UPDATE_SERVICE=mailmanager.service
