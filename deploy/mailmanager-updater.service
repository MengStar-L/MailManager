[Unit]
Description=Download, verify, and install a MailManager update
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/mailmanager/updater/inbox/request.json

[Service]
Type=oneshot
User=root
Group=mailmanager
EnvironmentFile=-/opt/mailmanager/config/mailmanager.env
WorkingDirectory=/opt/mailmanager/updater
ExecStart=/opt/mailmanager/bin/mailmanager update-apply
TimeoutStartSec=30min
TimeoutStopSec=3min
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/mailmanager/config
ReadWritePaths=/opt/mailmanager/bin /opt/mailmanager/updater
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
