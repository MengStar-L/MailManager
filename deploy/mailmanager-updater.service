[Unit]
Description=Download, verify, and install a MailManager update
Wants=network-online.target
After=network-online.target
ConditionPathExists=/var/lib/mailmanager-updater/inbox/request.json

[Service]
Type=oneshot
User=root
Group=mailmanager
EnvironmentFile=-/etc/mailmanager/mailmanager.env
WorkingDirectory=/var/lib/mailmanager-updater
ExecStart=/opt/mailmanager/bin/mailmanager update-apply
TimeoutStartSec=30min
TimeoutStopSec=3min
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/mailmanager
ReadWritePaths=/opt/mailmanager/bin /var/lib/mailmanager-updater
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
