[Unit]
Description=MailManager personal mail service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mailmanager
Group=mailmanager
EnvironmentFile=/etc/mailmanager/mailmanager.env
WorkingDirectory=/var/lib/mailmanager
ExecStart=/opt/mailmanager/bin/mailmanager serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/mailmanager /var/lib/mailmanager-updater
ReadWritePaths=/var/lib/mailmanager /var/lib/mailmanager-updater/inbox
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
