[Unit]
Description=MailManager personal mail service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mailmanager
Group=mailmanager
EnvironmentFile=/opt/mailmanager/config/mailmanager.env
WorkingDirectory=/opt/mailmanager/data
ExecStart=/opt/mailmanager/bin/mailmanager serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/mailmanager/config /opt/mailmanager/updater
ReadWritePaths=/opt/mailmanager/data /opt/mailmanager/updater/inbox
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
